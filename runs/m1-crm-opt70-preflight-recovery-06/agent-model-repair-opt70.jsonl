cription\":\"Read governed export audit requests\",\"key\":\"report_export_audit.read\"},{\"description\":\"Allow Runtime governed export status reconciliation\",\"key\":\"report_export_audit.update\"},{\"description\":\"Allow Runtime governed export download metadata creation\",\"key\":\"report_export_download.create\"},{\"description\":\"Read governed export download metadata\",\"key\":\"report_export_download.read\"},{\"description\":\"Run the governed Runtime scheduler command for acceptance and operations\",\"key\":\"scheduler.command\"},{\"description\":\"Act on assigned Workflow approval tasks\",\"key\":\"workflow.task.act\"}],\"project_source_layout\":\"module_v1\",\"report_export_controls\":[{\"approval_required\":false,\"audit_object\":\"report_export_audit\",\"download_object\":\"report_export_download\",\"export_action\":\"report_export_audit.request_lead_export\",\"key\":\"lead_detail_export_control\",\"masking_required\":false,\"max_rows\":10000,\"name\":\"Lead detail governed CSV export\",\"reason\":\"Director-only bounded, audited, requester-scoped lead detail CSV without contact name or phone\",\"record_mapping\":{\"audit_denied_status\":\"denied\",\"audit_downloaded_status\":\"downloaded\",\"audit_expired_status\":\"expired\",\"audit_prepared_status\":\"prepared\",\"audit_prepared_statuses\":[\"requested\"],\"audit_report_key_field\":\"report_key\",\"audit_requester_field\":\"requester_id\",\"audit_row_count_field\":\"row_count\",\"audit_scope_hash_field\":\"scope_hash\",\"audit_status_field\":\"status\",\"download_audit_field\":\"audit_id\",\"download_content_hash_field\":\"content_hash\",\"download_expires_at_field\":\"expires_at\",\"download_filename_field\":\"filename\"},\"report_key\":\"lead_detail_report\",\"sensitive_source_objects\":[\"lead\"],\"source_objects\":[\"lead\"],\"watermark\":false}],\"reports\":[{\"audience_roles\":[\"sales_director\"],\"evidence_requirements\":[{\"minimum_records\":1,\"object_key\":\"lead\",\"required_non_empty